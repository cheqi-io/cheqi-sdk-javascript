{
  "name": "@cheqi/sdk",
  "version": "2.3.0",
  "description": "Cheqi TypeScript SDK for encrypted receipt and credit note processing",
  "license": "MIT",
  "author": "Cheqi",
  "repository": {
    "type": "git",
    "url": "https://github.com/cheqi/cheqi-sdk.git",
    "directory": "cheqi-sdk-javascript"
  },
  "bugs": {
    "url": "https://github.com/cheqi/cheqi-sdk/issues"
  },
  "homepage": "https://cheqi.io",
  "keywords": [
    "cheqi",
    "receipt",
    "digital-receipt",
    "credit-note",
    "encryption",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./download": {
      "types": "./dist/download/index.d.ts",
      "default": "./dist/download/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node ./scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/sdk.test.js",
    "check:package": "npm run build && node ./scripts/check-package.mjs && npm pack --dry-run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm test && npm run check:package"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10"
  }
}
